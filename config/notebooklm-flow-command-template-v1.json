{
  "version": "1.0.0",
  "purpose": "Convert one high-level central-agent instruction into validated NotebookLM and Flow fanout tasks with consistent queue/output/readback fields.",
  "inputContract": {
    "required": ["projectKey", "goal", "sourceRefs"],
    "optional": ["language", "audience", "tone", "durationSec", "outputChecklist", "variants", "driveFolderId", "notebookUrl", "flowUrl", "deadline", "priority"],
    "defaults": {
      "language": "ko-KR",
      "audience": "general",
      "tone": "clear",
      "priority": "NORMAL",
      "parallelMode": "PROJECT_OUTPUT_TYPE",
      "startAckDeadlineSeconds": 60,
      "completionPolicy": "RESULT_SAVED_AND_READBACK"
    }
  },
  "normalize": {
    "inferMissingOutputSettings": true,
    "neverInventSourceFacts": true,
    "dedupeSameProjectOutputVariant": true,
    "preserveUserExplicitSettings": true,
    "expandOneCommandIntoChecklist": true
  },
  "outputTypes": {
    "NOTEBOOKLM_AUDIO": {
      "settings": ["language", "style", "durationSec", "focus", "persona"],
      "defaultTimeoutMode": "MEDIA_LENGTH_AWARE"
    },
    "NOTEBOOKLM_VIDEO": {
      "settings": ["language", "durationSec", "focus", "visualEmphasis", "persona"],
      "defaultTimeoutMode": "MEDIA_LENGTH_AWARE"
    },
    "NOTEBOOKLM_REPORT_PDF": {
      "settings": ["reportType", "depth", "language", "audience"],
      "defaultTimeoutMode": "DOCUMENT_COMPLETION_AWARE"
    },
    "NOTEBOOKLM_MIND_MAP": {
      "settings": ["depth", "focus"],
      "defaultTimeoutMode": "SHORT_ARTIFACT"
    },
    "FLOW_SCENE": {
      "settings": ["prompt", "ingredients", "frames", "camera", "lighting", "style", "aspectRatio", "durationSec"],
      "defaultTimeoutMode": "MEDIA_LENGTH_AWARE"
    },
    "FLOW_VARIANT": {
      "settings": ["baseSceneId", "variantAxis", "variantValue", "seedPolicy"],
      "defaultTimeoutMode": "MEDIA_LENGTH_AWARE"
    }
  },
  "fanoutRules": [
    "A single parent command may create multiple child tasks within the same project.",
    "Different output types in the same project may dispatch in parallel when no shared resource conflict is detected.",
    "Same project plus same output type plus same variant key is deduplicated.",
    "Different settings within one output type become explicit variants, not overwritten defaults.",
    "Serialize only shared Chrome session, renderer, download filename, or other proven conflicting resources."
  ],
  "queueMapping": {
    "sheet": "NotebookLM_Task_Queue",
    "columns": ["TASK_ID", "CONTENT_ID", "TASK_DATE", "TASK_TYPE", "TITLE", "SOURCE_TEXT", "INSTRUCTION", "LANGUAGE", "NOTEBOOK_URL", "DRIVE_FOLDER_ID", "AUTO_SUBMIT", "TIMEOUT_SECONDS", "STATUS", "OWNER_EMAIL", "CLAIMED_AT", "STARTED_AT", "COMPLETED_AT", "RESULT_TYPE", "RESULT_URL", "RESULT_FILE_ID", "RESULT_TEXT", "ERROR_MESSAGE", "CALLBACK_URL", "CALLBACK_TOKEN", "CREATED_AT", "UPDATED_AT"],
    "taskIdPattern": "{projectKey}_{outputType}_{variantKey}_{yyyyMMdd_HHmmss}",
    "sourceTextMustContain": ["parentCommandId", "projectKey", "outputType", "variantKey", "settings", "sourceRefs"],
    "instructionMustContain": ["goal", "successCriteria", "savePolicy", "readbackPolicy"]
  },
  "verification": {
    "start": ["CLAIMED", "STARTED_OR_RUNNING_WITHIN_60S"],
    "progress": ["PROGRESSING_OR_FILE_CHANGE_EVIDENCE"],
    "complete": ["RESULT_SAVED", "RESULT_READBACK", "EXPECTED_OUTPUT_TYPE_MATCH", "NO_DUPLICATE_COLLISION"],
    "failure": ["ROOT_CAUSE", "MINIMUM_FIX", "SAME_FIXTURE_RETEST"]
  },
  "centralAgentBehavior": {
    "onUserCommand": "NORMALIZE_THEN_FANOUT",
    "onMissingNonCriticalSetting": "APPLY_SAFE_DEFAULT_AND_RECORD",
    "onMissingCriticalSource": "HOLD_MISSING_SOURCE",
    "onConflict": "SERIALIZE_SHARED_RESOURCE_ONLY",
    "onResult": "WRITE_HISTORY_LIBRARY_TASK_INSTRUCTION_AND_WORKFLOW_EVIDENCE"
  }
}
