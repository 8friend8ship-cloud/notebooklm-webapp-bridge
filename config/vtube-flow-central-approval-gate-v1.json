{
  "version":"1.0.0",
  "purpose":"Gate every VTUBE→Google Flow video job behind Central Agent approval so credits/API are minimized and prompt/persona/language/bridge quality is verified before generation.",
  "approvalMode":"CENTRAL_AGENT_REQUIRED_BEFORE_CREDIT_SPEND",
  "apiPolicy":"MINIMUM_USE_FREE_FIRST_PRECHECK_FIRST",
  "preApprovalChecklist":[
    "VTUBE_TASK_GOAL_DEFINED",
    "TARGET_APP_FRONT_DEFINED",
    "FLOW_BRIDGE_HEALTH_PASS",
    "VTUBE_TO_FLOW_PAYLOAD_SCHEMA_PASS",
    "COMMON_PERSONA_PACK_LOCKED",
    "BACKDATA_ASSET_IDS_RESOLVED",
    "IMAGE_PREFLIGHT_PASS",
    "START_FRAME_READY",
    "END_FRAME_OR_NEXT_HANDOFF_DEFINED_WHEN_NEEDED",
    "PROMPT_STRUCTURED_AND_REVIEWED",
    "LANGUAGE_PROFILE_LOCKED",
    "KOREAN_PERSONA_LANGUAGE_QA_PASS_WHEN_APPLICABLE",
    "MODEL_FEATURE_SUPPORT_CHECKED",
    "MODEL_CREDIT_COST_CHECKED",
    "OUTPUT_COUNT_MINIMIZED",
    "EXPECTED_RESULT_AND_QA_CRITERIA_DEFINED"
  ],
  "bridgeChecks":[
    "VTUBE_COMMAND_ACCEPTED",
    "CENTRAL_COMMAND_NORMALIZED",
    "FLOW_PROJECT_RESOLVED",
    "ASSET_REFERENCES_RESOLVED",
    "PERSONA_REFERENCE_RESOLVED",
    "FRAME_REFERENCES_RESOLVED",
    "NO_STALE_OR_WRONG_PROJECT_CONTEXT",
    "START_ACK_WITHIN_POLICY",
    "RESULT_READBACK_AVAILABLE"
  ],
  "promptReview":{
    "sceneInstructionLanguage":"ENGLISH_PREFERRED_FOR_MODEL_CONTROL",
    "spokenDialogueLanguage":"LOCK_TO_TARGET_LANGUAGE_VERBATIM",
    "subtitleLanguage":"LOCK_TO_TARGET_LANGUAGE_VERBATIM",
    "properNouns":"PRESERVE_EXACT_NATIVE_OR_APPROVED_ROMANIZATION",
    "requiredSections":["SUBJECT","ACTION","ENVIRONMENT","CAMERA","LIGHTING","STYLE","CONTINUITY","TRANSITION","DIALOGUE","SUBTITLE_INTENT","AVOID"],
    "rejectIf":["PERSONA_AND_DIALOGUE_LANGUAGE_MISMATCH","PROMPT_CONTRADICTS_INGREDIENTS","AMBIGUOUS_PERSONA_IDENTITY","UNRESOLVED_FRAME_HANDOFF","UNAPPROVED_VARIANT_EXPANSION"]
  },
  "koreanPersonaGate":{
    "trigger":"personaNationality=KR OR personaLanguage=ko-KR OR requestedDialogueLanguage=ko-KR",
    "hardChecks":[
      "DIALOGUE_IS_NATURAL_KOREAN",
      "NO_UNINTENDED_JAPANESE_CHINESE_ENGLISH_SWITCH",
      "NO_MACHINE_TRANSLATION_STYLE_KOREAN",
      "HONORIFICS_MATCH_PERSONA_AND_AUDIENCE",
      "WORD_ORDER_AND_PARTICLES_NATURAL",
      "PROPER_NOUN_PRONUNCIATION_GUIDE_PRESENT_WHEN_RISKY",
      "NUMBERS_DATES_UNITS_READ_NATURALLY",
      "SUBTITLE_TEXT_MATCHES_APPROVED_KOREAN_SCRIPT",
      "VOICE_ACCENT_DOES_NOT_CONFLICT_WITH_KOREAN_PERSONA",
      "LIP_AUDIO_SUBTITLE_ALIGNMENT_ACCEPTABLE"
    ],
    "promptStrategy":"Use English for scene/camera/style control when helpful, but keep approved Korean dialogue/subtitles as exact quoted Korean fields. Do not translate approved Korean dialogue during Flow generation.",
    "failureAction":"DO_NOT_REGENERATE_BLINDLY; fix dialogue/voice reference/pronunciation guide/persona language payload first, then same-fixture retest."
  },
  "creditGuard":[
    "NO_FLOW_CREDIT_SPEND_BEFORE_CENTRAL_APPROVAL",
    "DEFAULT_OUTPUT_COUNT_1",
    "VALIDATE_PROMPT_ASSET_FRAME_BEFORE_HIGH_COST_MODEL",
    "DO_NOT_USE_API_FOR_CHECKS_AVAILABLE_FROM_LOCAL_DRIVE_SHEETS_GITHUB",
    "REGENERATE_ONLY_FAILED_DIMENSION_OR_CLIP",
    "LOG_MODEL_GENERATION_COUNT_AND_CREDIT_COST_PER_ATTEMPT"
  ],
  "postGenerationChecks":[
    "RESULT_READBACK_PASS",
    "PURPOSE_FIT_PASS",
    "PERSONA_CONSISTENCY_PASS",
    "KOREAN_LANGUAGE_QA_PASS_WHEN_APPLICABLE",
    "FRAME_CONTINUITY_PASS",
    "MOTION_CAMERA_PASS",
    "AUDIO_SUBTITLE_SYNC_PASS",
    "TARGET_APP_USABILITY_PASS",
    "CREDIT_EFFICIENCY_REVIEW_PASS"
  ],
  "learningWriteback":[
    "PROMPT_PATTERN","KOREAN_DIALOGUE_PATTERN","PRONUNCIATION_GUIDE","PERSONA_LANGUAGE_PROFILE","BRIDGE_FAILURE_PATTERN","ROOT_CAUSE","EFFECTIVE_FIX","CREDIT_WASTE_CAUSE","PREVENTION_RULE","VTUBE_PROMPT_TEMPLATE_ADJUSTMENT","FLOW_TEMPLATE_ADJUSTMENT"
  ],
  "completionRule":"VTUBE→Flow video is COMPLETE only after central approval evidence + Flow result readback + purpose-fit + language/persona + continuity + credit-efficiency audits all pass."
}
