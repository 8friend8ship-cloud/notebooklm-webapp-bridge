{
  "templateId": "GPT_IMAGE_AUTO_FALLBACK_BRIDGE_V1",
  "version": "1.2.0",
  "role": "image_generation_fallback_bridge",
  "currentAutomationStatus": "MANUAL_FUNCTION_PASS_AUTOMATION_PENDING",
  "priority": {
    "primary": "Flow Agent Bridge",
    "fallback": "ChatGPT Image Auto CANONICAL v8.6.0"
  },
  "quotaPolicy": {
    "bothProvidersAreFinite": true,
    "flowStateField": "flowQuotaState",
    "chatGptStateField": "chatGptQuotaState",
    "states": ["UNKNOWN", "AVAILABLE", "LOW", "BLOCKED", "COOLDOWN"],
    "rules": [
      "Use Flow while Flow is healthy and quota is AVAILABLE or LOW.",
      "Use ChatGPT Image Auto only when Flow fails or Flow quota is BLOCKED/COOLDOWN and ChatGPT quota is AVAILABLE or LOW.",
      "If both providers are BLOCKED/COOLDOWN, keep the task queued and do not blind-retry.",
      "Never infer an exact remaining quota number unless the provider UI/runtime exposes reliable evidence.",
      "Reserve fallback capacity for failed/important tasks instead of draining both providers in parallel."
    ],
    "retryBackoffMinutes": [5, 15, 60],
    "maxBlindRetries": 0,
    "defaultParallelism": {"flow": 1, "chatGptImage": 1},
    "duplicateParallelGeneration": false
  },
  "activation": {
    "normal": "DO_NOT_CALL_GPT_IMAGE_AUTO",
    "allowedWhen": [
      "FLOW_RUNTIME_UNAVAILABLE",
      "FLOW_GENERATION_FAILED",
      "FLOW_UI_CHANGED",
      "FLOW_LOGIN_SESSION_INVALID",
      "FLOW_CREDIT_OR_QUOTA_BLOCKED",
      "FLOW_RESULT_DOWNLOAD_FAILED"
    ],
    "requiresChangedEvidenceBeforeRetry": true,
    "parallelDuplicateGeneration": false
  },
  "generationContract": {
    "generator": "CHATGPT_DIRECT_IMAGE_GENERATION",
    "bridge": "ChatGPT Image Auto CANONICAL v8.6.0",
    "generationOccursIn": "existing authenticated ChatGPT browser session",
    "pythonGeneratesImage": false,
    "pythonRole": ["post_download_verification", "mime_extension_validation", "nonzero_byte_check", "hashing_if_available", "drive_queens_registration_helper"],
    "browserExtensionRole": ["receive_image_task", "submit_image_task", "detect_generation_complete", "download_original_image_file", "write_download_evidence", "handoff_to_drive_registration"],
    "downloadOwner": "CHROME_EXTENSION",
    "originalImageRequired": true
  },
  "queueContract": {
    "queue": "Image_Task_Queue",
    "states": ["READY", "WAIT_QUOTA", "CLAIMED", "STARTED", "GENERATED", "DOWNLOADED", "PYTHON_VERIFIED", "DRIVE_REGISTERED", "RESULT_ACK", "DONE", "HOLD"],
    "requiredTaskFields": ["taskId", "prompt", "sourceWorkflow", "fallbackReason", "createdAt"],
    "optionalTaskFields": ["referenceImageAssetIds", "aspectRatio", "outputHint", "priority", "flowQuotaState", "chatGptQuotaState", "retryAfter"]
  },
  "downloadContract": {
    "method": "CHROME_EXTENSION_DOWNLOAD_ORIGINAL",
    "acceptedExtensions": [".png", ".jpg", ".jpeg", ".webp"],
    "reject": ["html_page", "text_placeholder", "link_only", "zero_byte_file", "thumbnail_only", "screenshot_substitute"],
    "preserveOriginal": true,
    "overwriteOriginal": false,
    "localInbox": "C:/HomeDesignAutomationV7/CaptureBridge/INBOX/ChatGPTImage",
    "centralInbox": "00_중앙에이전트/CaptureBridge/INBOX/ChatGPTImage",
    "requiredEvidence": ["sourcePath", "bytes", "mimeType", "sha256_if_available", "taskId", "timestamp"]
  },
  "driveAssetContract": {
    "registerBeforeReuse": true,
    "requiredFields": ["SOURCE_URL_OR_SOURCE_CONTEXT", "DRIVE_FILE_ID", "DRIVE_PATH", "MIME_TYPE", "BYTES", "CONTENT_HASH_IF_AVAILABLE", "OWNER", "USAGE_SCOPE", "SOURCE_ASSET_ID_IF_DERIVED"],
    "derivedEditsBecomeNewAssets": true
  },
  "lineage": ["Image_Task_Queue", "ChatGPT_direct_generation", "Chrome_extension_original_download", "Python_verify", "Drive_asset", "Queens_raw", "Seed_candidate", "RESULT_ACK"],
  "automationGate": {
    "manualBrowserTestObserved": true,
    "automaticQueueIntake": "IN_PROGRESS",
    "automaticBrowserSubmit": "PENDING_EXACT_EXTENSION_INTERFACE_CONFIRMATION",
    "automaticCompletionDetection": "PENDING_EXACT_EXTENSION_INTERFACE_CONFIRMATION",
    "automaticOriginalDownload": "PENDING_EXACT_EXTENSION_INTERFACE_CONFIRMATION",
    "doNotMarkAutomatedUntil": "queue task is automatically claimed, submitted, generated, original downloaded, Python verified, Drive/Queens registered, and RESULT_ACK x2 succeeds without manual clicks"
  },
  "verification": {
    "installationEvidenceIsNotFunctionalPass": true,
    "manualSuccessIsNotAutomationPass": true,
    "requiredFunctionalRuns": 2,
    "sameFixture": true,
    "completionGate": "chatgpt_direct_image_generated + chrome_extension_original_download + python_file_verification + nonzero_bytes + Drive_file_id + asset_metadata + Queens_registration + RESULT_ACK x2"
  },
  "errorPolicy": {
    "blindRetry": false,
    "minimumFixOnly": true,
    "requiredFields": ["FAILED_STAGE", "EXPECTED", "ACTUAL", "ROOT_CAUSE", "MINIMUM_FIX", "SAME_FIXTURE_RETEST", "DO_NOT_REPEAT", "RESUME_POINT"]
  }
}
