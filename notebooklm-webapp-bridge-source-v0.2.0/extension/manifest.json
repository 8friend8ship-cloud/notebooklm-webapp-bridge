{
  "manifest_version": 3,
  "name": "NotebookLM WebApp Bridge",
  "version": "0.2.26",
  "description": "HomeDesign dedicated Chrome bridge preserving 0.2.25 durable handoff and adding D30 adoption of recent orphan CLAIMED LOCAL_POWERSHELL_ASYNC tasks after bridge/service-worker recovery, without permission, OAuth, Apps Script, Host, or normal-Chrome changes.",
  "permissions": ["alarms","identity","identity.email","scripting","sidePanel","storage","tabs"],
  "host_permissions": ["https://notebooklm.google.com/*","https://notebook.google.com/*","https://script.google.com/*","https://script.googleusercontent.com/*","https://notebooklm-webapp-bridge.vercel.app/*","http://127.0.0.1/*"],
  "externally_connectable": {"matches":["http://localhost/*","http://127.0.0.1/*","https://*.vercel.app/*"]},
  "background": {"service_worker":"worker.js","type":"module"},
  "action": {"default_title":"NotebookLM WebApp Bridge"},
  "content_scripts": [
    {"matches":["https://notebooklm.google.com/*","https://notebook.google.com/*"],"js":["content/notebooklm-runner.js"],"run_at":"document_idle"},
    {"matches":["https://notebooklm-webapp-bridge.vercel.app/*"],"js":["front-main.js"],"run_at":"document_start","world":"MAIN"},
    {"matches":["https://notebooklm-webapp-bridge.vercel.app/*"],"js":["front-extension.js"],"run_at":"document_start","world":"ISOLATED"}
  ]
}
