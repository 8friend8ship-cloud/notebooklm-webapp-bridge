{
  "manifest_version": 3,
  "name": "NotebookLM WebApp Bridge",
  "version": "0.2.61",
  "description": "D67 separates audio from other Studio artifact routes: audio uses the final player card kebab menu directly, with real-file verification retained as the completion gate.",
  "permissions": [
    "alarms",
    "identity",
    "identity.email",
    "scripting",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://notebooklm.google.com/*",
    "https://notebook.google.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://notebooklm-webapp-bridge.vercel.app/*",
    "http://127.0.0.1/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*",
      "https://*.vercel.app/*"
    ]
  },
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "NotebookLM WebApp Bridge"
  },
  "content_scripts": [
    {
      "matches": [
        "https://notebooklm.google.com/*",
        "https://notebook.google.com/*"
      ],
      "js": [
        "content/notebooklm-runner.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://notebooklm-webapp-bridge.vercel.app/*"
      ],
      "js": [
        "front-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://notebooklm-webapp-bridge.vercel.app/*"
      ],
      "js": [
        "front-extension.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
